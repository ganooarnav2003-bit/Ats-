# Clerk (required in production). Never expose CLERK_SECRET_KEY to the client.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Set to "true" to use persona-based demo login without Clerk keys (local/dev only).
NEXT_PUBLIC_DEMO_AUTH=true

# Supabase — service role is server-only. RLS still applies to the anon key + Clerk JWT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — server-only. Failures must never roll back appraisal writes.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Apex Performance <pms@helio.example>
APP_BASE_URL=http://localhost:3000
